# Public (safe in the browser; protected by RLS and column grants)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (NEVER prefix these with NEXT_PUBLIC_)
# Used by the server to read private data (seller emails, sellers, orders).
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key for the "new message" email to sellers.
RESEND_API_KEY=
# Optional sender, e.g. "Marketplace <hello@yourdomain.com>". Defaults to Resend's test sender.
EMAIL_FROM=

# Test 4: Stripe Connect (sandbox keys from the test instructions)
# Publishable key (public). Not required by the current redirect-based checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only: creates connected accounts, account links and Checkout Sessions.
STRIPE_SECRET_KEY=
# Server-only: whsec_... printed once by scripts/create-webhook.mjs.
STRIPE_WEBHOOK_SECRET=
