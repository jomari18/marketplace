# Public (safe in the browser; protected by RLS and column grants)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (NEVER prefix these with NEXT_PUBLIC_)
# Used only by /api/messages to look up the private seller email for notifications.
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key for the "new message" email to sellers.
RESEND_API_KEY=
# Optional sender, e.g. "Marketplace <hello@yourdomain.com>". Defaults to Resend's test sender.
EMAIL_FROM=
